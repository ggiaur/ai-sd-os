# Copy this file to .env in your PROJECT directory (not the motor's own
# directory — the motor refuses to run its pipeline on itself) and fill in
# real values. Never commit a real .env — it's already in .gitignore.

# Required for non-mock runs (AI_SD_OS_PROVIDER=anthropic or claude_code_cli).
ANTHROPIC_API_KEY=

# Optional: only needed if you plan to use sdk/provider_adapter.py::OpenAIAdapter.
OPENAI_API_KEY=

# Which AIProvider backs codegen/review when not in mock mode:
#   anthropic       - one-shot Anthropic API call (default)
#   claude_code_cli - shells out to the `claude` CLI (file-aware, iterative)
AI_SD_OS_PROVIDER=anthropic

# 3-tier model escalation ladder (see sdk/model_selector.py). Verified real
# model IDs as of 2026-07-31 — re-verify before changing (see CONTRIBUTING.md).
LIGHT_MODEL=claude-haiku-4-5-20251001
AI_MODEL=claude-sonnet-4-6
ESCALATION_MODEL=claude-sonnet-5

# One real API call per configured model at startup to catch a
# deprecated/renamed model early. Costs a few API calls; set to false to skip.
VALIDATE_MODELS_AT_STARTUP=true

# Run entirely without an API key, using deterministic MockProviderAdapter —
# for trying out the pipeline's mechanics (state machine, HITL gates, git
# flow) without spending anything. Overrides AI_SD_OS_PROVIDER when true.
MOCK_MODE=false

# How many DeveloperAgent <-> TestRunner retry cycles before PIPELINE_BLOCKED.
MAX_RETRIES=3
